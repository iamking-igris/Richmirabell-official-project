# --- Frontend -------------------------------------------------------------
# Google OAuth client id (VITE_ vars are exposed to the browser).
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# FastAPI backend origin. Either name works; VITE_API_BASE_URL wins if both set.
VITE_API_BASE_URL=https://richmirabel-backend.onrender.com/api/v1
# VITE_API_URL=https://richmirabel-backend.onrender.com/api/v1

# --- Backend (render.com) -------------------------------------------------
# These are NOT frontend variables. Set them in the Render service, never here:
#   GEMINI_API_KEY   - Google Gemini key used by every /api/v1/ai/* endpoint
#   GEMINI_MODEL     - optional model override (defaults to gemini-2.5-flash)
# The Gemini key can instead be saved at runtime in
# Admin > Settings > Gemini AI & OCR (stored in the database, never echoed back).
